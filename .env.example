# Porta pubblicata da Docker Compose.
LANGBRAIN_PORT=8000

# Chiavi dell'API, una per ruolo (header X-API-Key). Tutti gli endpoint, tranne GET /, richiedono una chiave valida.
#   tirocinante        sola lettura
#   medico_di_guardia  operatore di turno: cicli del grafo, comandi ai dispositivi, decisioni HITL (APPROVA/RESPINGI)
#   primario           amministratore: in più OVERRIDE, reset, agenti, politica HITL, simulazioni, proxy LLM
# Se nessuna chiave è impostata l'API resta aperta a tutti: impostarle sempre fuori da un ambiente di sviluppo locale.
API_KEY_TIROCINANTE=
API_KEY_MEDICO_DI_GUARDIA=
API_KEY_PRIMARIO=
# Chiave unica storica: vale come primario.
API_KEY=

# Runtime e persistenza. Docker Compose sovrascrive DB_PATH con /data/langbrain.db.
DB_PATH=langbrain.db
# Database: sqlite (predefinito, file DB_PATH) oppure postgres. Con postgres serve l'URL (Scaleway, Supabase...).
# LANGBRAIN_DB_BACKEND=postgres
# LANGBRAIN_DB_URL=postgresql://utente:password@host:5432/database?sslmode=require
# 1 = il server non parte senza una chiave API configurata.
# LANGBRAIN_REQUIRE_API_KEY=1
FLAG_TTL_MINUTES=60

# Timeout HTTP delle chiamate MAO, in secondi.
MAO_TIMEOUT_SECONDS=40

# Token di output delle chiamate degli agenti. I modelli con ragionamento ne consumano molti prima di rispondere:
# si parte da MINIMO e, se la risposta viene troncata, si raddoppia fino a LIMITE (la finestra di contesto è del modello).
MAO_MAX_TOKENS_MINIMO=8192
MAO_MAX_TOKENS_LIMITE=32768

# Ripiego su altri provider e modelli quando quello scelto fallisce. Se lasciato vuoto decide `fallback` in
# configurazione.toml (predefinito false: l'errore ferma il grafo e passa la palla all'operatore, HITL).
# 0 o 1 qui sostituiscono il file. Ordine dei provider e modelli di ripiego si scelgono in configurazione.toml.
MAO_FALLBACK=

# Provider predefinito: google_studio, openrouter, mistral, local oppure auto.
DEFAULT_PROVIDER=google_studio

# Google AI Studio / Gemini (sostituire il placeholder prima delle chiamate LLM).
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=replace-with-your-gemini-api-key
# In alternativa a GEMINI_API_KEY: GOOGLE_API_KEY=replace-with-your-google-api-key
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter (sostituire il placeholder prima delle chiamate LLM).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_REFERER=https://github.com/youssouf994/LangBrain
OPENROUTER_APP_TITLE=LangBrain

# Mistral (https://console.mistral.ai). Nessun modello è gratuito di per sé: il piano gratuito offre crediti mensili
# da cui vengono scalati i consumi. Il default è economico (0,15 $ per milione di token).
MISTRAL_API_KEY=replace-with-your-mistral-api-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=ministral-8b-latest

# Provider OpenAI-compatible locale. In Docker, Compose usa host.docker.internal.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# URL usato esclusivamente dal container Docker per raggiungere il modello sull'host.
LOCAL_MODEL_DOCKER_BASE_URL=http://host.docker.internal:8080/v1
LOCAL_API_KEY=not-required
LOCAL_MODEL=local-model

# Più persone insieme: `python -m app.serve` avvia più processi (worker). "auto" = uno per CPU, al massimo 4; un numero fisso
# lo sostituisce. Con `python -m uvicorn` (un processo solo) questa variabile non serve.
# LANGBRAIN_WORKERS=auto
# Registro degli accessi di uvicorn: 1 = una riga per ogni richiesta (predefinito: solo gli errori, niente rumore).
# LANGBRAIN_ACCESS_LOG=1

# Prompt opzionali: sostituiscono il RUOLO del modello; il formato di risposta lo aggiunge sempre il codice.
# Meglio scriverli nella sezione [prompt] di configurazione.toml (testo su più righe, ricarica a caldo); qui valgono
# come override di ambiente (es. in Docker). \n va a capo. Lasciare commentati per usare i default incorporati.
# PROMPT_BRAIN_ESCALATION=Sei il Brain di un impianto...          (vecchio nome: BRAIN_SYSTEM_PROMPT)
# PROMPT_BRAIN_ESCALATION_UTENTE=Agente: {source}\nDispositivo: {target}\nAzione: {action}   (vecchio: BRAIN_USER_PROMPT_TEMPLATE)
# PROMPT_TROUBLESHOOTING=Sei il modulo di troubleshooting...
# PROMPT_OVERRIDE=Sei il modulo di Arbitrato Semantico...
# PROMPT_CONTROLLO_MACRO=Sei il Brain e stai eseguendo il controllo di routine...
